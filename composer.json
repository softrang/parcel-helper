{
    "name": "softrang/parcel-helper",
    "type": "library",
    "description": "A small helper to place orders to Packzy (portal.packzy.com) using API keys from env/config.",
    "license": "MIT",
    "authors": [
        {
            "name": "softrang",
            "email": "softrang24@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Softrang\\ParcelHelper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Softrang\\ParcelHelper\\ParcelHelperServiceProvider"
            ],
            "aliases": {
                "ParcelHelper": "Softrang\\ParcelHelper\\Facades\\ParcelHelper"
            }
        }
    }
}